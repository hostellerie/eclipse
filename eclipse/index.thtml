{doctype}
<html lang="<?php echo eclipse_html_language(); ?>"{xmlns}>
<head>
<meta charset="{charset}"{xhtml}>
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=yes"{xhtml}>
<title>{page_title_and_site_name}</title>
<link rel="icon" href="{layout_url}/images/logo-mark.svg" type="image/svg+xml"{xhtml}>
<link rel="start contents" href="{site_url}"{xhtml}>
<?php echo eclipse_sitemap_header_link(); ?>
{feed_url}
{rel_links}
{plg_headercode}
<?php if (!eclipse_is_admin_request()) { ?>{jsonld}<?php } ?>
<?php echo eclipse_adsense_header_script(); ?>
<style><?php echo eclipse_theme_css_variables(); ?></style>
</head>
<body dir="{direction}" class="{layout_columns} <?php echo eclipse_theme_classes(); ?> <?php echo eclipse_context_classes(); ?>" itemscope="itemscope" itemtype="https://schema.org/WebPage">
{# start {templatelocation} #}
<a class="skip-link" href="#main-content">Skip to content</a>
<div id="container">
  <header id="header" role="banner" itemscope="itemscope" itemtype="https://schema.org/WPHeader">
    <div id="header-content"<?php $eclipseHeader = eclipse_theme_asset('header_image'); if ($eclipseHeader !== '') { ?> style="--eclipse-header-image:url('{layout_url}/<?php echo $eclipseHeader; ?>')"<?php } ?>>
      <div class="site-identity">
<?php $eclipseLogo = eclipse_theme_asset('logo'); if ($eclipseLogo !== '') { ?>
        <a class="site-logo" href="{site_url}" itemprop="url"><img src="{layout_url}/<?php echo $eclipseLogo; ?>" alt="{site_name}"{xhtml}></a>
<?php } ?>
        <div><p class="site_name" itemprop="name"><a href="{site_url}" itemprop="url">{site_name}</a></p><p class="site_slogan">{site_slogan}</p></div>
      </div>
    </div>
  </header>
<?php if (eclipse_menu_plugin_active()) { ?>
  <div id="navigation" class="navigation_bg eclipse-plugin-menu" role="navigation" aria-label="Main navigation" itemscope="itemscope" itemtype="https://schema.org/SiteNavigationElement">
    <div class="navigation_content">
<?php if (!empty(eclipse_theme_options()['mobile_menu'])) { ?>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="eclipse-menu-panel"><span aria-hidden="true">&#9776;</span><span>Menu</span></button>
<?php } ?>
      <div id="eclipse-menu-panel"><?php echo eclipse_menu_navigation(); ?></div>
    </div>
  </div>
<?php } else { ?>
  <nav id="navigation" aria-label="Main navigation" itemscope="itemscope" itemtype="https://schema.org/SiteNavigationElement">
    <div class="navigation_content">
<?php if (!empty(eclipse_theme_options()['mobile_menu'])) { ?>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navigation_ul"><span aria-hidden="true">&#9776;</span><span>Menu</span></button>
<?php } ?>
      <ul id="navigation_ul">{menu_elements}</ul>
    </div>
  </nav>
<?php } ?>
  <div id="wrapper">
    <div id="eclipse-admin-native-source" hidden><?php if (eclipse_is_admin_request() && function_exists('COM_adminMenu')) echo COM_adminMenu(); ?><?php echo eclipse_admin_studio_source(); ?></div>
    <div id="centerblocks">
      <main id="main-content" tabindex="-1" itemscope="itemscope" itemprop="mainContentOfPage" itemtype="https://schema.org/WebPageElement">
        <p class="welcome_msg">{welcome_msg}&nbsp;{datetime}</p>
        {breadcrumb_trail}
        {system_messsages}
        <?php echo eclipse_topic_heading(); ?>
        {content}
      </main>
    </div>
    {left_blocks}
    {right_blocks}
  </div>
  <footer id="footer" role="contentinfo" itemscope="itemscope" itemtype="https://schema.org/WPFooter">
    <?php
    require_once $_CONF['path_layout'] . 'includes/footer-controls.php';
    echo eclipse_footer_render_links_only();
    echo eclipse_footer_render_above_line();
    ?>
    <?php if (eclipse_footer_native_enabled()) { ?>
    <div id="footer-content" class="eclipse-footer-native-grid">
      <div class="eclipse-footer-column eclipse-footer-column-1">
        <?php $eclipseColumnOne = eclipse_footer_column_one(); if ($eclipseColumnOne !== '') { echo $eclipseColumnOne; } elseif (defined('VERSION') && version_compare(VERSION, '2.1.3', '>=')) { ?>{copyright_msg}<?php } else { ?>{copyright_notice}<?php } ?>
      </div>
      <div class="eclipse-footer-column eclipse-footer-column-2">
        <?php $eclipseColumnTwo = eclipse_footer_column_two(); if ($eclipseColumnTwo !== '') { echo $eclipseColumnTwo; } elseif (defined('VERSION') && version_compare(VERSION, '2.1.3', '>=')) { ?>{trademark_msg}<?php } ?>
      </div>
      <div class="eclipse-footer-column eclipse-footer-column-3">
        <?php $eclipseColumnThree = eclipse_footer_column_three(); if ($eclipseColumnThree !== '') { echo $eclipseColumnThree; } else { ?>
          <span class="powered_by">{powered_by}&nbsp;<a href="https://www.geeklog.net/">Geeklog</a></span><br{xhtml}>
          <span class="execution_textandtime">{execution_textandtime}</span>
        <?php } ?>
      </div>
    </div>
    <?php } ?>
  </footer>
</div>
{plg_footercode}
{# end {templatelocation} #}
</body>
</html>
