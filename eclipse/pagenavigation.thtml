{# begin {templatelocation} #}
<nav class="gl-pagenav" aria-label="Pagination">{message}<span>{start_first_anchortag}{lang_first}{end_first_anchortag}</span><span>{start_previous_anchortag}{lang_previous}{end_previous_anchortag}</span>{pages}</nav>
<!-- BEGIN message --><p>{message_text}</p><!-- END message -->
<!-- BEGIN page --><span class="page-number">{page_number}</span><!-- END page -->
<!-- BEGIN page-current --><strong class="page-number current" aria-current="page">{page_number}</strong><!-- END page-current -->
<!-- BEGIN nav-end --><span>{start_next_anchortag}{lang_next}{end_next_anchortag}</span><span>{start_last_anchortag}{lang_last}{end_last_anchortag}</span><!-- END nav-end -->
<!-- BEGIN nav-open-ended --><span>{open_ended}</span><!-- END nav-open-ended -->
{# end {templatelocation} #}
