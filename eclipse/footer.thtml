      </main>
    </div>
    {left_blocks}
    {right_blocks}
  </div>
  <footer id="footer" role="contentinfo">
    <?php
    require_once $_CONF['path_layout'] . 'includes/footer-controls.php';
    echo eclipse_footer_render_links_only();
    echo eclipse_footer_render_above_line();
    ?>
    <?php if (eclipse_footer_native_enabled()) { ?>
    <?php if (defined('VERSION') && version_compare(VERSION, '2.2.0', '<')) { ?>
    <div id="footer-content" class="eclipse-footer-native-grid is-two-column">
      <div class="eclipse-footer-column eclipse-footer-column-1">
        <?php
        $eclipseColumnOne = eclipse_footer_column_one();
        $eclipseColumnTwo = eclipse_footer_column_two();
        if ($eclipseColumnOne !== '' || $eclipseColumnTwo !== '') {
            if ($eclipseColumnOne !== '') echo $eclipseColumnOne;
            if ($eclipseColumnOne !== '' && $eclipseColumnTwo !== '') echo '<br>';
            if ($eclipseColumnTwo !== '') echo $eclipseColumnTwo;
        } else {
        ?>{copyright_notice}<?php } ?>
      </div>
      <div class="eclipse-footer-column eclipse-footer-column-3">
        <?php $eclipseColumnThree = eclipse_footer_column_three(); if ($eclipseColumnThree !== '') { echo $eclipseColumnThree; } else { ?>
          <span class="powered_by">{powered_by}&nbsp;<a href="https://www.geeklog.net/">Geeklog</a></span><br{xhtml}>
          <span class="execution_textandtime">{execution_textandtime}</span>
        <?php } ?>
      </div>
    </div>
    <?php } else { ?>
    <div id="footer-content" class="eclipse-footer-native-grid">
      <div class="eclipse-footer-column eclipse-footer-column-1">
        <?php $eclipseColumnOne = eclipse_footer_column_one(); if ($eclipseColumnOne !== '') { echo $eclipseColumnOne; } else { ?>{copyright_msg}<?php } ?>
      </div>
      <div class="eclipse-footer-column eclipse-footer-column-2">
        <?php $eclipseColumnTwo = eclipse_footer_column_two(); if ($eclipseColumnTwo !== '') { echo $eclipseColumnTwo; } else { ?>{trademark_msg}<?php } ?>
      </div>
      <div class="eclipse-footer-column eclipse-footer-column-3">
        <?php $eclipseColumnThree = eclipse_footer_column_three(); if ($eclipseColumnThree !== '') { echo $eclipseColumnThree; } else { ?>
          <span class="powered_by">{powered_by}&nbsp;<a href="https://www.geeklog.net/">Geeklog</a></span><br{xhtml}>
          <span class="execution_textandtime">{execution_textandtime}</span>
        <?php } ?>
      </div>
    </div>
    <?php } ?>
    <?php } ?>
  </footer>
</div>
{plg_footercode}
</body>
</html>
