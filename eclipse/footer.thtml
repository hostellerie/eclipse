      </main>
    </div>
    {left_blocks}
    {right_blocks}
  </div>
  <footer id="footer" role="contentinfo">
    <?php
    require_once $_CONF['path_layout'] . 'includes/footer-controls.php';
    echo eclipse_footer_render_links_only();
    echo eclipse_footer_render_above_line();
    ?>
    <?php if (eclipse_footer_native_enabled()) { ?>
    <div id="footer-content" class="eclipse-footer-native-grid">
      <div class="eclipse-footer-column eclipse-footer-column-1">
        <?php
        if (!eclipse_footer_uses_default(1)) {
            echo eclipse_footer_column_one();
        } elseif (defined('VERSION') && version_compare(VERSION, '2.1.3', '>=')) {
        ?>{copyright_msg}<?php
        } else {
            global $LANG01;
            $eclipseCopyrightLabel = isset($LANG01[93]) ? $LANG01[93] : 'Copyright';
            $eclipseSiteName = isset($_CONF['site_name']) ? $_CONF['site_name'] : 'Geeklog';
            echo htmlspecialchars($eclipseCopyrightLabel . ' © ' . date('Y') . ' ' . $eclipseSiteName, ENT_QUOTES, 'UTF-8');
        }
        ?>
      </div>
      <div class="eclipse-footer-column eclipse-footer-column-2">
        <?php
        if (!eclipse_footer_uses_default(2)) {
            echo eclipse_footer_column_two();
        } elseif (defined('VERSION') && version_compare(VERSION, '2.1.3', '>=')) {
        ?>{trademark_msg}<?php
        } else {
            global $LANG01;
            echo htmlspecialchars(isset($LANG01[94]) ? $LANG01[94] : 'All trademarks and copyrights on this page are owned by their respective owners.', ENT_QUOTES, 'UTF-8');
        }
        ?>
      </div>
      <div class="eclipse-footer-column eclipse-footer-column-3">
        <?php if (!eclipse_footer_uses_default(3)) { echo eclipse_footer_column_three(); } else { ?>
          <span class="powered_by">{powered_by}&nbsp;<a href="https://www.geeklog.net/">Geeklog</a></span><br{xhtml}>
          <span class="execution_textandtime">{execution_textandtime}</span>
        <?php } ?>
      </div>
    </div>
    <?php } ?>
  </footer>
</div>
{plg_footercode}
</body>
</html>
