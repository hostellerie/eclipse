<!-- comment/comment.thtml { -->
<article class="block-comment-content eclipse-comment-card level-{indent}">
  <header class="eclipse-comment-header">
    <h3 class="comment_title">{title}</h3>
    <p class="comment_author">{lang_authoredby}&nbsp;{author_link}&nbsp;{lang_on}&nbsp;{date}</p>
  </header>
  <div class="comment_content">{comments}</div>
  <nav class="comment_navi" {hide_if_preview}>
    {reply_option} {parent_link} {delete_option}
    <a href="{site_url}/comment.php?mode=view&amp;cid={cid}" rel="bookmark" title="{lang_permlink}" class="eclipse-comment-permalink">#</a>
  </nav>
</article>
<!-- } comment/comment.thtml -->
