{# start {templatelocation} #}

<form action="{form_url}" method="post" class="uk-form eclipse-admin-list-search-form">
  <div class="admin-list-search">
    <div class="admin-list-search-main">
      <label for="eclipse-admin-list-query" class="admin-list-search-label">{lang_search}</label>
      <div class="admin-list-search-field">
        <input type="search" id="eclipse-admin-list-query" name="q" value="{last_query}" autocomplete="off"{xhtml}>
        <button type="submit" value="{lang_submit}" class="uk-button">{lang_submit}</button>
      </div>
    </div>

    <div class="admin-list-search-filters">
      <div class="admin-list-filter-primary">
        {filter}
      </div>
      <label for="eclipse-admin-query-limit" class="admin-list-filter-limit">
        <span>{lang_limit_results}</span>
        <select id="eclipse-admin-query-limit" name="query_limit">
          <option value="10" {10_selected}>10</option>
          <option value="20" {20_selected}>20</option>
          <option value="50" {50_selected}>50</option>
          <option value="75" {75_selected}>75</option>
          <option value="100" {100_selected}>100</option>
          <option value="200" {200_selected}>200</option>
          <option value="500" {500_selected}>500</option>
        </select>
      </label>
    </div>

    <div class="admin-list-search-status" role="status" aria-live="polite">
      <span>{lang_records_found}</span>
      <strong>{records_found}</strong>
    </div>
  </div>
</form>

{# end {templatelocation} #}
