{# start {templatelocation} #}

<form action="{form_url}" method="post" class="uk-form eclipse-admin-list-search-form">
  <section class="eclipse-admin-list-search uk-panel uk-panel-box" aria-label="{lang_search}">
    <div class="eclipse-admin-list-search-main">
      <label for="eclipse-admin-list-query" class="uk-form-label">{lang_search}</label>
      <div class="uk-grid uk-grid-small" data-uk-grid-margin>
        <div class="uk-width-1-1 uk-width-medium-4-5">
          <input type="search" id="eclipse-admin-list-query" name="q" value="{last_query}" autocomplete="off" class="uk-width-1-1"{xhtml}>
        </div>
        <div class="uk-width-1-1 uk-width-medium-1-5">
          <button type="submit" value="{lang_submit}" class="uk-button uk-width-1-1">{lang_submit}</button>
        </div>
      </div>
    </div>

    <div class="uk-grid uk-grid-small eclipse-admin-list-search-filters" data-uk-grid-margin>
      <div class="uk-width-1-1 uk-width-large-2-3">
        <div class="eclipse-admin-list-filter-primary">
          {filter}
        </div>
      </div>
      <div class="uk-width-1-1 uk-width-large-1-3">
        <label for="eclipse-admin-query-limit" class="uk-form-label eclipse-admin-list-filter-limit">
          <span>{lang_limit_results}</span>
          <select id="eclipse-admin-query-limit" name="query_limit" class="uk-form-width-small">
            <option value="10" {10_selected}>10</option>
            <option value="20" {20_selected}>20</option>
            <option value="50" {50_selected}>50</option>
            <option value="75" {75_selected}>75</option>
            <option value="100" {100_selected}>100</option>
            <option value="200" {200_selected}>200</option>
            <option value="500" {500_selected}>500</option>
          </select>
        </label>
      </div>
    </div>

    <div class="eclipse-admin-list-search-status uk-text-small" role="status" aria-live="polite">
      <strong>{records_found}</strong>
      <span>{lang_records_found}</span>
    </div>
  </section>
</form>

{# end {templatelocation} #}
