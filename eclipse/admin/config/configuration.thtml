{noscript}
<style>
/* Small compatibility guardrails for Geeklog 2.1.x/Denim. */
body.theme-eclipse.eclipse-admin-configuration #geeklog_config_editor .eclipse-config-title {
    margin-bottom: .85rem !important;
}
body.theme-eclipse.eclipse-admin-configuration #geeklog_config_editor #config_menu {
    padding: 1.1rem !important;
}

/* Keep tabs and the active panel visually connected and compact. */
body.theme-eclipse.eclipse-admin-configuration #config_content #tabs > ul {
    margin-bottom: 0 !important;
    padding: .4rem .45rem 0 !important;
    gap: .35rem !important;
    border-bottom: 0 !important;
}
body.theme-eclipse.eclipse-admin-configuration #config_content #tabs > ul > li > a {
    min-height: 2.35rem !important;
    padding: .45rem .75rem !important;
}
body.theme-eclipse.eclipse-admin-configuration #config_content .eclipse-config-panel {
    box-sizing: border-box;
    margin: 0 0 1rem !important;
    padding: .8rem 1rem 1rem !important;
    background: var(--eclipse-surface);
    border: 1px solid var(--eclipse-border);
    border-top: 0;
    border-radius: 0 0 .7rem .7rem;
}
body.theme-eclipse.eclipse-admin-configuration #config_content .eclipse-config-panel fieldset {
    margin: 0 !important;
    padding: 0 !important;
    min-height: 0 !important;
    border: 0 !important;
    border-radius: 0;
}
body.theme-eclipse.eclipse-admin-configuration #config_content .eclipse-config-panel legend {
    margin: 0 0 .55rem !important;
    padding: 0 !important;
    font-size: 1rem !important;
    line-height: 1.35 !important;
}
body.theme-eclipse.eclipse-admin-configuration #config_content .eclipse-config-fields {
    gap: .55rem !important;
}
body.theme-eclipse.eclipse-admin-configuration #config_content .eclipse-config-field {
    min-height: 0 !important;
    padding: .75rem .9rem !important;
    gap: .5rem .9rem !important;
}
body.theme-eclipse.eclipse-admin-configuration #config_content .eclipse-config-field input[type="text"],
body.theme-eclipse.eclipse-admin-configuration #config_content .eclipse-config-field input[type="password"],
body.theme-eclipse.eclipse-admin-configuration #config_content .eclipse-config-field input[type="email"],
body.theme-eclipse.eclipse-admin-configuration #config_content .eclipse-config-field input[type="url"],
body.theme-eclipse.eclipse-admin-configuration #config_content .eclipse-config-field input[type="number"],
body.theme-eclipse.eclipse-admin-configuration #config_content .eclipse-config-field select {
    min-height: 2.55rem !important;
    height: auto !important;
    padding-top: .5rem !important;
    padding-bottom: .5rem !important;
}

@media (max-width: 46.25rem) {
    body.theme-eclipse.eclipse-admin-configuration #geeklog_config_editor {
        box-sizing: border-box !important;
        width: calc(100% - .8rem) !important;
        max-width: calc(100% - .8rem) !important;
        margin-left: .4rem !important;
        margin-right: .4rem !important;
    }
    body.theme-eclipse.eclipse-admin-configuration #geeklog_config_editor .eclipse-config-layout {
        width: 100% !important;
        margin: 0 !important;
    }
    body.theme-eclipse.eclipse-admin-configuration #config_content .eclipse-config-panel {
        padding: .75rem .8rem .85rem !important;
    }
}
</style>
<div id="geeklog_config_editor" class="eclipse-config-editor" style="display:none;">
    <form method="post" action="{site_admin_url}/configuration.php" name="group" class="uk-form eclipse-config-group-form">
        <div>
            <input type="hidden" value="{open_group}" name="conf_group"{xhtml}>
            <input type="hidden" value="" name="subgroup"{xhtml}>
            <input type="hidden" name="{gltoken_name}" value="{gltoken}"{xhtml}>
        </div>
    </form>

    <h1 class="eclipse-config-title">Configuration</h1>

    <div class="eclipse-config-layout">
        <aside id="config_menu" class="eclipse-config-sidebar">
            <section id="search-configuration-container" class="uk-form eclipse-config-search" role="search">
                <input name="search-configuration" id="search-configuration" type="search" value="{search_configuration_value}" placeholder="{search_configuration_label}" aria-label="{search_configuration_label}" autocomplete="off"{xhtml}>
                <input name="tab-id" id="tab-id" type="hidden" value="{tab_id_value}"{xhtml}>
            </section>
            <nav class="eclipse-config-navigation">
                {config_menu}
            </nav>
        </aside>

        <div id="config_content" class="eclipse-config-content">
            <div class="saved_message{error_validation_class} eclipse-config-message" style="display:{show_changeblock}">
                {lang_changes_made}
                {lang_error_validation_occurs}
                {change_block}
            </div>

            <div id="config_main" class="eclipse-config-main">
                <form action="{site_admin_url}/configuration.php" method="post" name="subgroup" class="uk-form eclipse-config-form">
                    <div>
                        <input type="hidden" name="conf_group" value="{open_group}"{xhtml}>
                        <input type="hidden" name="sub_group" value="{open_sg}"{xhtml}>
                        <input type="hidden" name="{gltoken_name}" value="{gltoken}"{xhtml}>
                        <input type="hidden" name="form_submit" value="true"{xhtml}>
                    </div>

                    <div id="tabs" class="eclipse-config-tabs">
                        {tab_li}

                        <!-- BEGIN tab -->
                        <section id="{tab_id}" class="eclipse-config-panel">
                            <!-- BEGIN notes -->
                            <div class="notes eclipse-config-notes">
                                <h4>{tab_display}</h4>
                                <p class="last">{tab_help}</p>
                                <span class="warningsmall">{tab_warning}</span>
                            </div>
                            <!-- END notes -->

                            <div class="eclipse-config-fields">
                                {tab_contents}
                            </div>
                        </section>
                        <!-- END tab -->
                    </div>

                    <div id="bottom_buttons" class="aligncenter eclipse-config-actions">
                        <input type="submit" id="save_changes" value="{lang_save_changes}"{xhtml}>
                        <input type="submit" id="form_reset" name="form_reset" value="{lang_reset_form}"{xhtml}>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
