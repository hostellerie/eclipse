{doctype}
<html lang="<?php echo eclipse_html_language(); ?>">
<head>
<meta charset="{charset}"{xhtml}>
<meta name="viewport" content="width=device-width, initial-scale=1"{xhtml}>
<title>{page_title_and_site_name}</title>
<?php
$eclipseSiteFavicon = !empty($_CONF['path_images']) ? rtrim($_CONF['path_images'], '/\\') . '/favicon.png' : '';
$eclipseSiteFaviconUrl = '';
if ($eclipseSiteFavicon !== '' && is_file($eclipseSiteFavicon)) {
    $eclipsePathImages = str_replace('\\', '/', rtrim((string) $_CONF['path_images'], '/\\'));
    $eclipsePathHtml = !empty($_CONF['path_html']) ? str_replace('\\', '/', rtrim((string) $_CONF['path_html'], '/\\')) : '';
    if ($eclipsePathHtml !== '' && strpos($eclipsePathImages . '/', $eclipsePathHtml . '/') === 0) {
        $eclipseImagesRelative = ltrim(substr($eclipsePathImages, strlen($eclipsePathHtml)), '/');
        $eclipseSiteFaviconUrl = rtrim((string) $_CONF['site_url'], '/') . '/' . ($eclipseImagesRelative !== '' ? $eclipseImagesRelative . '/' : '') . 'favicon.png';
    } else {
        $eclipseSiteFaviconUrl = rtrim((string) $_CONF['site_url'], '/') . '/images/favicon.png';
    }
}
?>
<?php if ($eclipseSiteFaviconUrl !== '') { ?>
<link rel="icon" href="<?php echo htmlspecialchars($eclipseSiteFaviconUrl, ENT_QUOTES, 'UTF-8'); ?>" type="image/png"{xhtml}>
<?php } else { ?>
<link rel="icon" href="{layout_url}/images/logo-mark.svg" type="image/svg+xml"{xhtml}>
<?php } ?>
<link rel="start contents" href="{site_url}"{xhtml}>
<?php echo eclipse_sitemap_header_link(); ?>
{feed_url}
{rel_links}
{plg_headercode}
<?php if (!eclipse_is_admin_request()) { ?>{jsonld}<?php } ?>
<?php echo eclipse_adsense_header_script(); ?>
<style><?php echo eclipse_theme_css_variables(); ?></style>
<?php if (eclipse_is_admin_request()) { ?>
<?php $eclipseAdminI18nPath = rtrim($_CONF['path_layout'], '/\\') . '/js/admin-i18n.js'; $eclipseAdminI18nVersion = is_file($eclipseAdminI18nPath) ? (string) @filemtime($eclipseAdminI18nPath) : eclipse_theme_version(); ?>
<script>window.ECLIPSE_LANG=<?php echo eclipse_lang_js(); ?>;</script>
<script src="{layout_url}/js/admin-i18n.js?v=<?php echo rawurlencode($eclipseAdminI18nVersion); ?>"></script>
<?php } ?>
</head>
<body dir="{direction}" class="{layout_columns} <?php echo eclipse_theme_classes(); ?> <?php echo eclipse_context_classes(); ?>">
<a class="skip-link" href="#main-content"><?php echo htmlspecialchars(eclipse_lang('skip_to_content'), ENT_QUOTES, 'UTF-8'); ?></a>
<div id="container">
  <header id="header" role="banner">
    <div id="header-content"<?php $eclipseHeader = eclipse_theme_asset('header_image'); if ($eclipseHeader !== '') { ?> style="--eclipse-header-image:url('{layout_url}/<?php echo $eclipseHeader; ?>')"<?php } ?>>
      <div class="site-identity">
<?php $eclipseLogo = eclipse_theme_asset('logo'); if ($eclipseLogo !== '') { ?>
        <a class="site-logo" href="{site_url}"><img src="{layout_url}/<?php echo $eclipseLogo; ?>" alt="{site_name}"{xhtml}></a>
<?php } ?>
        <div><p class="site_name"><a href="{site_url}">{site_name}</a></p><p class="site_slogan">{site_slogan}</p></div>
      </div>
    </div>
  </header>
<?php if (eclipse_menu_plugin_active()) { ?>
<?php require_once rtrim($_CONF['path_layout'], '/\\') . '/includes/menu-navigation.php'; ?>
  <div id="navigation" class="navigation_bg eclipse-plugin-menu" role="navigation" aria-label="<?php echo htmlspecialchars(eclipse_lang('main_navigation'), ENT_QUOTES, 'UTF-8'); ?>">
    <div class="navigation_content">
<?php if (!empty(eclipse_theme_options()['mobile_menu'])) { ?>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="eclipse-menu-panel"><span aria-hidden="true">&#9776;</span><span><?php echo htmlspecialchars(eclipse_lang('menu'), ENT_QUOTES, 'UTF-8'); ?></span></button>
<?php } ?>
      <div id="eclipse-menu-panel"><?php echo eclipse_menu_navigation_resolved(); ?></div>
    </div>
  </div>
<?php } else { ?>
  <nav id="navigation" aria-label="<?php echo htmlspecialchars(eclipse_lang('main_navigation'), ENT_QUOTES, 'UTF-8'); ?>">
    <div class="navigation_content">
<?php if (!empty(eclipse_theme_options()['mobile_menu'])) { ?>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navigation_ul"><span aria-hidden="true">&#9776;</span><span><?php echo htmlspecialchars(eclipse_lang('menu'), ENT_QUOTES, 'UTF-8'); ?></span></button>
<?php } ?>
      <ul id="navigation_ul">{menu_elements}</ul>
    </div>
  </nav>
<?php } ?>
  <div id="wrapper">
    <div id="eclipse-admin-native-source" hidden><?php if (eclipse_is_admin_request() && function_exists('COM_adminMenu')) echo COM_adminMenu(); ?><?php echo eclipse_translate_theme_studio_html(eclipse_admin_studio_source()); ?></div>
    <div id="centerblocks">
      <main id="main-content" tabindex="-1">
        <p class="welcome_msg">{welcome_msg}&nbsp;{datetime}</p>
        {breadcrumb_trail}
        <?php echo eclipse_topic_heading(); ?>
