{# begin {templatelocation} #}

<form class="eclipse-forum-moderation-card" action="{site_url}/forum/moderation.php" method="post">
    <input type="hidden" name="msgid" value="{fortopicid}"{xhtml}>
    <input type="hidden" name="confirm_move" value="1"{xhtml}>

    <div class="eclipse-forum-setting">
        <label for="form-movetoforum">{$LANG_GF03[selectforum]}:</label>
        <select id="form-movetoforum" name="movetoforum">{forumoptions}</select>
    </div>

    <div class="eclipse-forum-setting">
        <label for="form-movetitle">{$LANG_GF02[msg186]}:</label>
        <input id="form-movetitle" type="text" name="movetitle" value="{topictitle}" maxlength="255"{xhtml}>
    </div>

    {split_topic}

    <div class="eclipse-forum-moderation-actions">
        <button class="uk-button uk-button-primary" type="submit" name="submit" value="{$LANG_GF03[movetopic]}">{$LANG_GF03[movetopic]}</button>
        <button class="uk-button" type="submit" name="submit" value="{$LANG_GF01[CANCEL]}">{$LANG_GF01[CANCEL]}</button>
    </div>
</form>

<!-- BEGIN split_topic -->
<fieldset class="eclipse-forum-moderation-choice">
    <legend>{$LANG_GF03[splitheading]}</legend>
    <label class="eclipse-forum-choice-row"><input type="radio" name="splittype" value="remaining" checked="checked"{xhtml}> {$LANG_GF03[splitopt1]}</label>
    <label class="eclipse-forum-choice-row"><input type="radio" name="splittype" value="single"{xhtml}> {$LANG_GF03[splitopt2]}</label>
</fieldset>
<!-- END split_topic -->

{# end {templatelocation} #}
