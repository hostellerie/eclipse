{# begin {templatelocation} #}

<style>
.eclipse-forum-post-moderation select,
.eclipse-forum-mod-form select {
    box-sizing: border-box;
    min-height: 2.5rem;
    padding: .4rem 2rem .4rem .65rem;
    border: 1px solid var(--eclipse-border);
    border-radius: .45rem;
    background-color: var(--eclipse-surface) !important;
    color: var(--eclipse-text) !important;
    font: inherit;
}

.eclipse-forum-post-moderation select:hover,
.eclipse-forum-post-moderation select:focus,
.eclipse-forum-mod-form select:hover,
.eclipse-forum-mod-form select:focus {
    background-color: var(--eclipse-surface) !important;
    color: var(--eclipse-text) !important;
    border-color: var(--eclipse-primary);
}

.eclipse-forum-post-moderation select:focus-visible,
.eclipse-forum-mod-form select:focus-visible {
    outline: 2px solid var(--eclipse-primary);
    outline-offset: 2px;
}

.eclipse-forum-post-moderation select option,
.eclipse-forum-mod-form select option {
    background: var(--eclipse-surface);
    color: var(--eclipse-text);
}
</style>

<section class="eclipse-forum-section eclipse-forum-topic-header" aria-labelledby="eclipse-forum-topic-title">
    <nav class="eclipse-forum-breadcrumb" aria-label="Breadcrumb">
        <ol>
            <li><a href="{site_url}/forum/index.php">{forum_home}</a></li>
            <li><a href="{site_url}/forum/index.php?category={category_id}">{cat_name}</a></li>
            <li><a href="{site_url}/forum/index.php?forum={forum_id}">{forum_name}</a></li>
        </ol>
    </nav>

    <header class="eclipse-forum-section-header">
        <div>
            <h1 id="eclipse-forum-topic-title" class="eclipse-forum-page-title">
                <a href="viewtopic.php?showtopic={topic_id}">{subject}</a>
            </h1>
            {!if geeklog_topic}
            <p class="eclipse-forum-context">{lang_geeklog_topic} {geeklog_topic}</p>
            {!endif}
        </div>

        <div class="eclipse-forum-actions" aria-label="Topic actions">
            {topicmenu_link}
        </div>
    </header>
</section>

{# end {templatelocation} #}
