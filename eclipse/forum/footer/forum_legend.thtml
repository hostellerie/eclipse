{# begin {templatelocation} #}

<section class="eclipse-forum-footer-section eclipse-forum-legend" aria-label="Forum legend">
    <ul class="eclipse-forum-legend-list">
        {!if normal_msg}<li>{normal_icon} <span>{normal_msg}</span></li>{!endif}
        {!if sticky_msg}<li>{sticky_icon} <span>{sticky_msg}</span></li>{!endif}
        {!if locked_msg}<li>{locked_icon} <span>{locked_msg}</span></li>{!endif}
        {!if normalnew_msg}<li>{normalnew_icon} <span>{normalnew_msg}</span></li>{!endif}
        {!if stickynew_msg}<li>{stickynew_icon} <span>{stickynew_msg}</span></li>{!endif}
        {!if lockednew_msg}<li>{lockednew_icon} <span>{lockednew_msg}</span></li>{!endif}
    </ul>
</section>

{# end {templatelocation} #}
