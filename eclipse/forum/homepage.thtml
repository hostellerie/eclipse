{# begin {templatelocation} #}

<?php
$eclipseForumCategoryId = isset($_GET['category']) ? (int) $_GET['category'] : 0;
$eclipseForumCategoryName = '';
if ($eclipseForumCategoryId > 0 && isset($_TABLES['forum_categories']) && function_exists('DB_getItem')) {
    $eclipseForumCategoryName = (string) DB_getItem(
        $_TABLES['forum_categories'],
        'cat_name',
        'id = ' . $eclipseForumCategoryId
    );
}
?>
<section class="eclipse-forum-home" aria-labelledby="eclipse-forum-index-title">
    <header class="eclipse-forum-section-header eclipse-forum-home-header">
        <div class="eclipse-forum-heading-copy">
            <h1 id="eclipse-forum-index-title" class="eclipse-forum-page-title">
<?php if ($eclipseForumCategoryName !== '') { ?>
                <?php echo htmlspecialchars($eclipseForumCategoryName, ENT_QUOTES, 'UTF-8'); ?>
<?php } else { ?>
                Forum - <?php echo htmlspecialchars(isset($_CONF['site_name']) ? (string) $_CONF['site_name'] : '', ENT_QUOTES, 'UTF-8'); ?><?php if (!empty($_CONF['site_slogan'])) { ?> : <?php echo htmlspecialchars((string) $_CONF['site_slogan'], ENT_QUOTES, 'UTF-8'); ?><?php } ?>
<?php } ?>
            </h1>
        </div>
    </header>

    {category_records}
</section>

{# end {templatelocation} #}
