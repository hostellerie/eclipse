{# begin {templatelocation} #}

{breadcrumb_trail}
{block_start}
<div class="eclipse-staticpage-content">
{content}
</div>
{block_end}
{!if likes_control}<p class="uk-text-center">{likes_control}</p>{!endif}
<div class="eclipse-staticpage-meta">
    {!if lastupdate}<span class="eclipse-staticpage-meta-item">{lastupdate}</span>{!if hits}<span class="eclipse-staticpage-meta-separator" aria-hidden="true">|</span>{!endif}{!endif}
    {!if hits}<span class="eclipse-staticpage-meta-item">{hits}</span>{!endif}
    {!if print_icon}<span class="eclipse-staticpage-actions">{print_icon}{edit_icon}</span>{!else}{!if edit_icon}<span class="eclipse-staticpage-actions">{edit_icon}</span>{!endif}{!endif}
</div>
{commentbar}

{# end {templatelocation} #}
